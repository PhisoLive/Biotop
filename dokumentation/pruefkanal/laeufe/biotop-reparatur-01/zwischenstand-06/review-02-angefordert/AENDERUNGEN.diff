+            assert e['modellaufrufe'] == 0 and e['kosten_eur'] == 0
+        assert list(db.iterdump()) == vor_db
+        assert {str(p.relative_to(werk)): p.read_bytes() for p in werk.rglob('*') if p.is_file()} == vor_werk
