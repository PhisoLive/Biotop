+
+VERTRAG = 'tests/vertraege/test_vertrag_abnehmer_lieferant.py'
+VERTRAGSTEST = VERTRAG + '::test_eichprobe_vertrag_neue_zusicherung'
+
+
+@pytest.fixture
+def vertragswerk(tmp_path):
